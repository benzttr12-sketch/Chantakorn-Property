# Safe default: sample listings stored in this browser.
# Choose local, supabase, or firebase. Restart/rebuild after changing public values.
NEXT_PUBLIC_DATA_BACKEND=local
NEXT_PUBLIC_ENABLE_DEMO_AUTH=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_PATH=

# Supabase: apply supabase/schema.sql first. Never use a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional Firebase catalog connection. See README for authentication limitations.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# build:pages defaults to a public sample catalog with demo login disabled.
# Set these in the shell or GitHub Actions variables, not .env.local.
DEPLOY_DATA_BACKEND=local
DEPLOY_DEMO_AUTH=false
