# Backend Selection ('firebase' | 'supabase' | 'local')
NEXT_PUBLIC_DATA_BACKEND=firebase
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_API_BASE_URL=

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Server-side Gemini API key (Cloudflare secret in production; Flash-Lite, no model fallback)
GEMINI_API_KEY=

# Google Maps Platform API Key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# LINE webhook replies (server-only Cloudflare secrets from the same Messaging API channel)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# Optional for customer replies; required only for private staff push notifications
LINE_TARGET_USER_ID=
# Public deployed source revision; set automatically by npm run deploy:worker
APP_BUILD_SHA=
