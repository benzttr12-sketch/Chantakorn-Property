# The public Firebase web configuration is versioned in firebase.web.json.
# Set local explicitly for a read-only preview using sample listings.
NEXT_PUBLIC_DATA_BACKEND=firebase
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: set ALL fields below only when switching to a different Firebase project.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_DATABASE_ID=

# Optional: enable after provisioning Cloud Storage and deploying storage.rules (requires Blaze).
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
