# Backend Selection ('firebase' | 'supabase' | 'local')
NEXT_PUBLIC_DATA_BACKEND=firebase
NEXT_PUBLIC_SITE_URL=

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Server-Side Gemini API Key (Managed by AI Studio runtime)
GEMINI_API_KEY=

# Google Maps Platform API Key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# LINE Messaging API (server-only Vercel production environment variables)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Private staff notifications only; customer webhook replies do not require recipients
LINE_TARGET_USER_ID=
# Optional additional approved staff LINE user IDs, comma-separated
LINE_ADMIN_USER_IDS=
