# Server-Side Gemini API Key (Managed by AI Studio runtime)
GEMINI_API_KEY=

# LINE Messaging API (Optional fallback; can also be managed via Admin Settings UI)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
