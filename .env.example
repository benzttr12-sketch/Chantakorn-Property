# Firebase handles Auth and business data; the property catalog defaults to D1/R2.
# For a sample preview without Cloudflare catalog reads, set DATA_BACKEND=local
# and PROPERTY_STORAGE_BACKEND=firebase (both NEXT_PUBLIC_ variables below).
# The catalog backend is independent; local alone does not disable Cloudflare reads.
NEXT_PUBLIC_DATA_BACKEND=firebase
NEXT_PUBLIC_SITE_URL=

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Server-Side Gemini API Key (Managed by AI Studio runtime)
GEMINI_API_KEY=

# Google Maps Platform API Key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# LINE Messaging API (server-only Vercel production environment variables)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Private staff notifications only; customer webhook replies do not require recipients
LINE_TARGET_USER_ID=
# Optional additional approved staff LINE user IDs, comma-separated
LINE_ADMIN_USER_IDS=

# Property catalog defaults from next.config.mjs. Use an isolated Worker for development writes.
# Hosting environment overrides take precedence; these values do not verify a live deployment.
NEXT_PUBLIC_PROPERTY_STORAGE_BACKEND=cloudflare
NEXT_PUBLIC_CLOUDFLARE_API_ORIGIN=https://chantakorn-property-api.chantakorn-property.workers.dev
# Catalog reads include public pages, sitemap and LINE property cards.
# Auth, featured-agent profiles, inquiries, LINE follower/settings data and valuation remain on Firebase.
# Worker staff roles and assigned catalog agents are separate D1 records.
# Before switching an existing catalog to firebase: pause writes and reconcile all newer D1/R2 data.
