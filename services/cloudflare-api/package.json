{
  "name": "@chantakorn/cloudflare-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "db:local": "wrangler d1 migrations apply chantakorn-property-dev --local",
    "db:remote": "wrangler d1 migrations apply chantakorn-property-dev --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "4.13.5",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260127.0",
    "drizzle-kit": "0.31.10",
    "typescript": "5.8.2",
    "wrangler": "4.151.2",
    "@types/node": "22.15.0"
  }
}
