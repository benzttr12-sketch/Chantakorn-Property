{
  "name": "@chantakorn/cloudflare-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "db:local": "wrangler d1 migrations apply chantakorn-property-dev --local",
    "db:remote": "wrangler d1 migrations apply chantakorn-property-dev --remote",
    "deploy": "wrangler deploy",
    "test:integration": "node --test tests/runtime.integration.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "hono": "4.13.13",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "@types/node": "22.15.0",
    "esbuild": "0.25.12",
    "miniflare": "5.20261019.0-beta",
    "typescript": "5.8.2",
    "wrangler": "4.151.2"
  }
}
