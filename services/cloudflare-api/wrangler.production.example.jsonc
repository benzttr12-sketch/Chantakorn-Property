{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chantakorn-property-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chantakorn-property-production",
      "database_id": "REPLACE_WITH_PRODUCTION_D1_UUID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PROPERTY_MEDIA",
      "bucket_name": "chantakorn-property-media-production"
    },
    {
      "binding": "PRIVATE_MEDIA",
      "bucket_name": "chantakorn-inquiry-private-production"
    }
  ],
  "triggers": {
    "crons": ["0 */6 * * *"]
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://chantakornproperty.com",
    "FIREBASE_PROJECT_ID": "replace-with-firebase-project-id",
    "PROPERTY_WRITES_ENABLED": "false",
    "PROPERTY_PUBLICATION_ENABLED": "false",
    "MEDIA_WRITES_ENABLED": "false",
    "MEDIA_SWEEP_ENABLED": "false",
    // Enable only after the browser client and real staging uploads are verified.
    "MEDIA_UPLOAD_SESSIONS_REQUIRED": "false",
    "MEDIA_UPLOAD_HOURLY_LIMIT": "120",
    "MEDIA_SESSION_HOURLY_LIMIT": "60",
    "PUBLIC_CATALOG_CACHE_ENABLED": "false"
  }
}
