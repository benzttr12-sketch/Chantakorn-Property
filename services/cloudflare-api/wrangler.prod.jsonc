{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chantakorn-property-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chantakorn-property-prod",
      "database_id": "cab8ea30-1575-4436-b124-1aa20e8cc363",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PROPERTY_MEDIA",
      "bucket_name": "chantakorn-property-media-prod"
    },
    {
      "binding": "PRIVATE_MEDIA",
      "bucket_name": "chantakorn-inquiry-private-prod"
    }
  ],
  "triggers": {
    "crons": ["0 */6 * * *"]
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://chantakornproperty.com,https://benzttr12-sketch.github.io,http://localhost:3000",
    "FIREBASE_PROJECT_ID": "project-d417918c-0e3b-4185-812",
    "PROPERTY_WRITES_ENABLED": "true",
    "PROPERTY_PUBLICATION_ENABLED": "true",
    "MEDIA_WRITES_ENABLED": "true",
    "MEDIA_SWEEP_ENABLED": "true",
    "MEDIA_UPLOAD_SESSIONS_REQUIRED": "true",
    "MEDIA_UPLOAD_HOURLY_LIMIT": "120",
    "MEDIA_SESSION_HOURLY_LIMIT": "60",
    "PUBLIC_CATALOG_CACHE_ENABLED": "true"
  }
}
