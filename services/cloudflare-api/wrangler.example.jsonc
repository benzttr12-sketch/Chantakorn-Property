{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chantakorn-property-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chantakorn-property-dev",
      "database_id": "REPLACE_WITH_DEV_D1_UUID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PROPERTY_MEDIA",
      "bucket_name": "chantakorn-property-media-dev"
    },
    {
      "binding": "PRIVATE_MEDIA",
      "bucket_name": "chantakorn-inquiry-private-dev"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "http://localhost:3000",
    "FIREBASE_PROJECT_ID": "replace-with-firebase-project-id",
    "PROPERTY_WRITES_ENABLED": "false",
    "PROPERTY_PUBLICATION_ENABLED": "false",
    "MEDIA_WRITES_ENABLED": "false",
    "PUBLIC_CATALOG_CACHE_ENABLED": "false"
  }
}
