{
  "name": "chantakorn-property",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "eslint src --ext .ts,.tsx --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "audit:security": "npm audit --audit-level=low",
    "test:rules": "npx --yes firebase-tools@15.33.0 emulators:exec --project demo-chantakorn-security --config firebase.test.json --only firestore \"node tests/firestore-rules.cjs\"",
    "build:pages": "node scripts/build-pages.mjs",
    "preview:pages": "node scripts/preview-pages.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.3.1",
    "@vercel/oidc": "^4.0.0",
    "@vis.gl/react-google-maps": "^1.10.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "firebase": "10.14.1",
    "google-auth-library": "^11.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.453.0",
    "next": "15.5.27",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/d3": "^7.4.3",
    "@types/leaflet": "^1.9.12",
    "@types/node": "20.17.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.27",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "typescript": "5.8.2"
  },
  "overrides": {
    "postcss": "$postcss",
    "@firebase/auth": {
      "undici": "6.29.0"
    },
    "@firebase/auth-compat": {
      "undici": "6.29.0"
    },
    "@firebase/functions": {
      "undici": "6.29.0"
    },
    "@firebase/storage": {
      "undici": "6.29.0"
    },
    "@firebase/firestore": {
      "undici": "6.29.0",
      "@grpc/grpc-js": "1.14.5"
    },
    "eslint-config-next": {
      "@next/eslint-plugin-next": {
        ".": "14.2.35",
        "glob": "10.5.0"
      }
    }
  }
}
