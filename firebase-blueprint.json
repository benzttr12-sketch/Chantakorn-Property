{
  "entities": {
    "properties": {
      "title": "Property Listing",
      "description": "Real estate property details in Hat Yai and Songkhla",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "property_type": { "type": "string" },
        "status": { "type": "string" },
        "price": { "type": "number" },
        "province": { "type": "string" },
        "district": { "type": "string" },
        "subdistrict": { "type": "string" },
        "address": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "bedrooms": { "type": "number" },
        "bathrooms": { "type": "number" },
        "parking": { "type": "number" },
        "land_size": { "type": "number" },
        "usable_area": { "type": "number" },
        "year_built": { "type": "number" },
        "furniture": { "type": "string" },
        "features": { "type": "array", "items": { "type": "string" } },
        "cover_image": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "facing_direction": { "type": "string" },
        "feng_shui": { "type": "object" },
        "featured": { "type": "boolean" },
        "published": { "type": "boolean" },
        "internal_notes": { "type": "string", "description": "Private, non-public agent notes regarding property condition, owner details, or negotiation history" },
        "agent_id": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["title", "slug", "property_type", "status", "price", "province", "district", "published"]
    },
    "inquiries": {
      "title": "Customer Inquiries & Consignments",
      "description": "Messages sent by visitors interested in properties or consigning property",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "property_id": { "type": "string" },
        "property_title": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "line_id": { "type": "string" },
        "message": { "type": "string" },
        "inquiry_type": { "type": "string" },
        "status": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["name", "phone", "message", "inquiry_type", "status", "created_at"]
    },
    "profiles": {
      "title": "User Profiles & Roles",
      "description": "Admin, Agent, and User account profiles",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "full_name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "AGENT", "USER"] },
        "phone": { "type": "string" },
        "line_id": { "type": "string" },
        "facebook": { "type": "string" },
        "avatar_url": { "type": "string" },
        "bio": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "full_name", "email", "role"]
    },
    "agents": {
      "title": "Featured Agents",
      "description": "Consultant team & featured agents for property listings and bookings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "name": { "type": "string" },
        "rank": { "type": "string" },
        "title": { "type": "string" },
        "phone": { "type": "string" },
        "line_id": { "type": "string" },
        "facebook": { "type": "string" },
        "email": { "type": "string" },
        "photo_url": { "type": "string" },
        "bio": { "type": "string" },
        "specialty": { "type": "string" },
        "zone": { "type": "string" },
        "experienceYears": { "type": "number" },
        "closedDeals": { "type": "number" },
        "rating": { "type": "number" },
        "languages": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "name", "phone"]
    },
    "property_history": {
      "title": "Property History Logs",
      "description": "Audit trail logging price changes, status updates, agent edits, and listing history",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "property_id": { "type": "string" },
        "property_title": { "type": "string" },
        "change_type": { "type": "string" },
        "previous_value": { "type": "string" },
        "new_value": { "type": "string" },
        "diff_summary": { "type": "string" },
        "actor_name": { "type": "string" },
        "actor_email": { "type": "string" },
        "actor_role": { "type": "string" },
        "timestamp": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "property_id", "change_type", "diff_summary", "timestamp"]
    },
    "system_activities": {
      "title": "System Activity Feed",
      "description": "Log of critical system events such as property additions, inquiry updates, and user role changes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string", "enum": ["property", "inquiry", "user_role", "system"] },
        "action": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "target_id": { "type": "string" },
        "target_name": { "type": "string" },
        "actor_name": { "type": "string" },
        "actor_email": { "type": "string" },
        "actor_role": { "type": "string" },
        "metadata": { "type": "object" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "category", "action", "title", "description", "created_at"]
    }
  },
  "firestore": {
    "/properties/{propertyId}": {
      "schema": "properties",
      "description": "Collection of all real estate properties"
    },
    "/inquiries/{inquiryId}": {
      "schema": "inquiries",
      "description": "Collection of customer inquiry submissions"
    },
    "/profiles/{userId}": {
      "schema": "profiles",
      "description": "Collection of user profiles and administrative roles"
    },
    "/agents/{agentId}": {
      "schema": "agents",
      "description": "Collection of featured agents and consultant team members"
    },
    "/property_history/{logId}": {
      "schema": "property_history",
      "description": "Collection of audit trail events and change history"
    },
    "/system_activities/{activityId}": {
      "schema": "system_activities",
      "description": "Collection of system activity feed items"
    }
  }
}
