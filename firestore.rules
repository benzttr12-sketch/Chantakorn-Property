rules_version = '2';

// Data model (the web app stores ISO-8601 strings, not Timestamp objects):
// properties/{id}: id and created_at are immutable strings. Required strings:
// title (1..200), slug (1..200), description (1..20000), province/district
// (1..120), furniture (0..200), cover_image (HTTPS, <=2048). Required enums:
// property_type and status. Numeric price/areas/coordinates/counts are bounded.
// images contains 1..20 HTTPS URLs; features contains <=20 bounded strings.
// published/featured are booleans. Optional: subdistrict/address/year_built,
// author_id/agent_id identify the AGENT who posted the listing. The public
// agent map has only the responsible agent's business-contact information.
// inquiries/{id}: immutable id, name (1..120), phone (1..30), message (1..5000),
// inquiry_type, created_at. Optional property_id/property_title/line_id and a
// strictly bounded consignment_details map (at most 5 compressed JPEG photos).
// Only status may change. Visitors may submit; only staff may read this PII.
// profiles/{uid}: immutable id/email/created_at; required full_name and role.
// Optional phone/avatar_url/line_id/bio/updated_at. Self-created role is USER.
// Only the owner and authorized ADMIN directory may read private profiles.
// Staff roles must first be bootstrapped using a trusted server/IAM identity.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'ADMIN';
    }
    function isStaff() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role in ['ADMIN', 'AGENT'];
    }
    function isAgent() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'AGENT';
    }
    function validString(value, minimum, maximum) {
      return value is string && value.size() >= minimum && value.size() <= maximum;
    }
    function optionalString(data, field, maximum) {
      return !(field in data) || validString(data[field], 0, maximum);
    }
    function validNumber(value, minimum, maximum) {
      return value is number && value >= minimum && value <= maximum;
    }
    function optionalNumber(data, field, maximum) {
      return !(field in data) || validNumber(data[field], 0, maximum);
    }
    function validId(value) {
      return validString(value, 1, 128) && value.matches('^[A-Za-z0-9_-]+$');
    }
    function validDate(value) {
      // This preserves the app's ISO string schema and checks format only.
      return validString(value, 24, 24)
        && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$');
    }
    function optionalDate(data, field) {
      return !(field in data) || validDate(data[field]);
    }
    function validUrl(value) {
      return validString(value, 9, 2048) && value.matches('^https://[^ /]+/?.*$');
    }
    function optionalUrl(data, field) {
      return !(field in data) || data[field] == '' || validUrl(data[field]);
    }
    function validEmail(value) {
      return validString(value, 3, 254) && value.matches('^[^ @]+@[^ @]+[.][^ @]+$');
    }
    function validPropertyType(value) {
      return value in ['house', 'land', 'condo', 'commercial', 'investment', 'consignment'];
    }
    function validImages(values) {
      // Validate all URLs in one expression to stay below the Rules evaluator budget.
      // The separator count rejects embedded newlines; non-string elements fail join/match.
      let joined = values.join('\n');
      return values is list && values.size() >= 1 && values.size() <= 20
        && joined.size() <= 40960 && joined.split('\n').size() == values.size()
        && joined.matches('^https://[^ \\n]+(\\nhttps://[^ \\n]+)*$');
    }
    function validFeatures(values) {
      return values is list && values.size() <= 20
        && values.hasOnly(['เครื่องปรับอากาศ', 'ที่จอดรถส่วนตัว', 'สวนหย่อมส่วนตัว',
          'สระว่ายน้ำ', 'ห้องครัวบิวท์อิน', 'กล้องวงจรปิด CCTV',
          'ระบบรักษาความปลอดภัย 24 ชม.', 'ติดถนนใหญ่',
          'ใกล้มหาวิทยาลัยสงขลานครินทร์ (ม.อ.)', 'ใกล้เซ็นทรัลหาดใหญ่', 'ใกล้สนามบินหาดใหญ่']);
    }
    function isAssignedAgent(agentId) {
      return validId(agentId)
        && get(/databases/$(database)/documents/profiles/$(agentId)).data.role == 'AGENT';
    }
    function validAgent(agent, agentId) {
      // This public listing snapshot deliberately excludes the account email.
      return agent is map
        && agent.keys().hasAll(['id', 'name', 'title', 'phone', 'line_id', 'photo_url', 'bio'])
        && agent.keys().hasOnly(['id', 'name', 'title', 'phone', 'line_id', 'photo_url', 'bio'])
        && agent.id == agentId && validString(agent.name, 1, 120)
        && validString(agent.title, 1, 120) && validString(agent.phone, 0, 30)
        && validString(agent.line_id, 0, 100) && validString(agent.bio, 0, 2000)
        && (agent.photo_url == '' || validUrl(agent.photo_url))
        && agent.values().join('').size() <= 8000;
    }
    function isValidProperty(data, propertyId) {
      return data.keys().hasAll([
          'id', 'title', 'slug', 'description', 'property_type', 'status', 'price',
          'province', 'district', 'latitude', 'longitude', 'bedrooms', 'bathrooms',
          'parking', 'land_size', 'usable_area', 'furniture', 'features',
          'cover_image', 'images', 'featured', 'published', 'author_id', 'agent_id',
          'agent', 'created_at'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'slug', 'description', 'property_type', 'status', 'price',
          'province', 'district', 'subdistrict', 'address', 'latitude', 'longitude',
          'bedrooms', 'bathrooms', 'parking', 'land_size', 'usable_area',
          'year_built', 'furniture', 'features', 'cover_image', 'images',
          'featured', 'published', 'author_id', 'agent_id', 'agent', 'created_at', 'updated_at'
        ])
        && validId(data.id) && data.id == propertyId
        && validString(data.title, 1, 200) && validString(data.slug, 1, 200)
        && !data.slug.matches('.*[/\\\\?#].*')
        && validString(data.description, 1, 20000)
        && validPropertyType(data.property_type) && data.status in ['sale', 'rent']
        && validNumber(data.price, 1, 1000000000000)
        && validString(data.province, 1, 120) && validString(data.district, 1, 120)
        && optionalString(data, 'subdistrict', 120) && optionalString(data, 'address', 1000)
        && validNumber(data.latitude, -90, 90) && validNumber(data.longitude, -180, 180)
        && data.bedrooms is int && validNumber(data.bedrooms, 0, 1000)
        && data.bathrooms is int && validNumber(data.bathrooms, 0, 1000)
        && data.parking is int && validNumber(data.parking, 0, 10000)
        && validNumber(data.land_size, 0, 100000000) && validNumber(data.usable_area, 0, 100000000)
        && (!('year_built' in data) || (data.year_built is int && validNumber(data.year_built, 1800, 3000)))
        && validString(data.furniture, 0, 200) && validFeatures(data.features)
        && validUrl(data.cover_image) && validImages(data.images) && data.cover_image in data.images
        && data.featured is bool && data.published is bool
        && validId(data.author_id) && validId(data.agent_id)
        && data.author_id == data.agent_id && isAssignedAgent(data.agent_id)
        && validAgent(data.agent, data.agent_id)
        && validDate(data.created_at) && optionalDate(data, 'updated_at');
    }
    function validPhotoAt(photos, index) {
      return photos.size() <= index
        || (validString(photos[index], 24, 125000)
          && photos[index].matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}$'));
    }
    function validConsignment(data) {
      return data is map
        && data.keys().hasAll(['property_type', 'province', 'district', 'expected_price'])
        && data.keys().hasOnly(['property_type', 'province', 'district', 'subdistrict',
          'expected_price', 'land_size', 'usable_area', 'photos_count', 'photos'])
        && validPropertyType(data.property_type)
        && validString(data.province, 1, 120) && validString(data.district, 1, 120)
        && optionalString(data, 'subdistrict', 120)
        && validNumber(data.expected_price, 1, 1000000000000)
        && optionalNumber(data, 'land_size', 100000000) && optionalNumber(data, 'usable_area', 100000000)
        && (!('photos' in data) || (data.photos is list && data.photos.size() <= 5
          && validPhotoAt(data.photos, 0) && validPhotoAt(data.photos, 1)
          && validPhotoAt(data.photos, 2) && validPhotoAt(data.photos, 3) && validPhotoAt(data.photos, 4)))
        && (!('photos_count' in data) || (data.photos_count is int
          && data.photos_count == data.get('photos', []).size()));
    }
    function isValidInquiry(data, inquiryId) {
      return data.keys().hasAll(['id', 'name', 'phone', 'message', 'inquiry_type', 'status', 'created_at'])
        && data.keys().hasOnly(['id', 'property_id', 'property_title', 'name', 'phone',
          'line_id', 'message', 'inquiry_type', 'status', 'consignment_details', 'created_at'])
        && validId(data.id) && data.id == inquiryId
        && validString(data.name, 1, 120) && validString(data.phone, 1, 30)
        && validString(data.message, 1, 5000) && optionalString(data, 'line_id', 100)
        && (!('property_id' in data) || validId(data.property_id))
        && optionalString(data, 'property_title', 200)
        && data.inquiry_type in ['inquiry', 'viewing', 'consignment_sell']
        && data.status in ['new', 'contacted', 'scheduled', 'closed']
        && (data.inquiry_type != 'viewing' || 'property_id' in data)
        && ((data.inquiry_type == 'consignment_sell' && validConsignment(data.consignment_details))
          || (data.inquiry_type != 'consignment_sell' && !('consignment_details' in data)))
        && validDate(data.created_at);
    }
    function validInquiryProperty(data) {
      return !('property_id' in data)
        || (get(/databases/$(database)/documents/properties/$(data.property_id)).data.published == true
          && data.get('property_title', '') == get(/databases/$(database)/documents/properties/$(data.property_id)).data.title);
    }
    function isValidProfile(data, userId) {
      return data.keys().hasAll(['id', 'full_name', 'email', 'role', 'created_at'])
        && data.keys().hasOnly(['id', 'full_name', 'email', 'role', 'phone',
          'avatar_url', 'line_id', 'bio', 'created_at', 'updated_at'])
        && validString(data.id, 1, 128) && data.id == userId
        && validString(data.full_name, 1, 120) && validEmail(data.email)
        && data.role in ['ADMIN', 'AGENT', 'USER']
        && optionalString(data, 'phone', 30) && optionalUrl(data, 'avatar_url')
        && optionalString(data, 'line_id', 100) && optionalString(data, 'bio', 2000)
        && validDate(data.created_at) && optionalDate(data, 'updated_at');
    }

    match /properties/{propertyId} {
      // Public queries must explicitly filter published == true.
      allow read: if resource.data.published == true || isStaff();
      // A listing is always created by the AGENT who is publicly shown on it.
      allow create: if isAgent() && request.resource.data.author_id == request.auth.uid
        && isValidProperty(request.resource.data, propertyId);
      allow update: if isValidProperty(request.resource.data, propertyId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'created_at'])
        && (
          (isAgent() && resource.data.author_id == request.auth.uid
            && request.resource.data.author_id == resource.data.author_id
            && request.resource.data.agent_id == resource.data.agent_id)
          || (isAdmin()
            && request.resource.data.author_id == resource.data.author_id
            && request.resource.data.agent_id == resource.data.agent_id
            && request.resource.data.agent == resource.data.agent)
        );
      allow delete: if isAdmin() || (isAgent() && resource.data.author_id == request.auth.uid);
    }
    match /inquiries/{inquiryId} {
      allow create: if isValidInquiry(request.resource.data, inquiryId)
        && request.resource.data.status == 'new' && validInquiryProperty(request.resource.data);
      allow read: if isStaff();
      // The inbox permits staff to reopen or reschedule leads, but not edit PII.
      allow update: if isStaff() && isValidInquiry(request.resource.data, inquiryId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }
    match /profiles/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidProfile(request.resource.data, userId)
        && request.resource.data.role == 'USER'
        && request.resource.data.email == request.auth.token.email;
      allow update: if isValidProfile(request.resource.data, userId)
        && ((isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['full_name', 'phone', 'avatar_url', 'line_id', 'bio', 'updated_at']))
          || (isAdmin() && !isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['full_name', 'phone', 'role', 'updated_at'])));
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
