rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    function isStaff() {
      return isSignedIn() && (
        request.auth.token.email == 'benzttr12@gmail.com' ||
        request.auth.token.email == 'agent@chantakornproperty.com' ||
        (exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && 
         (getUserData().role == 'ADMIN' || getUserData().role == 'AGENT'))
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'benzttr12@gmail.com' ||
        (exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && 
         getUserData().role == 'ADMIN')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 1. Global safety net (Default deny catch-all)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Properties collection
    match /properties/{propertyId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    // 3. Inquiries (Customer contacts/submissions)
    match /inquiries/{inquiryId} {
      allow create: if true; // anyone can submit an inquiry
      allow read, update, delete: if isStaff(); // confidential inbox
    }

    // 4. Profiles (User accounts and roles)
    match /profiles/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId || 
        isStaff() || 
        resource.data.role in ['ADMIN', 'AGENT']
      );
      
      // Prevent self-assigned roles during signup (must register as USER, unless they are verified root admin or agent)
      allow create: if isOwner(userId) && (
        request.resource.data.role == 'USER' || 
        (request.resource.data.role == 'ADMIN' && request.auth.token.email == 'benzttr12@gmail.com') ||
        (request.resource.data.role == 'AGENT' && request.auth.token.email == 'agent@chantakornproperty.com')
      );
      
      // Owners can edit their own profile fields except 'role' (privilege escalation protection)
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) || isAdmin();
      
      allow delete: if isAdmin();
    }

    // 5. Featured Agents
    match /agents/{agentId} {
      allow read: if true; // public team info
      allow write: if isStaff();
    }

    // 6. Property history audit logs
    match /property_history/{logId} {
      allow read, create: if isStaff();
      allow update: if false;
      allow delete: if false;
    }

    // 7. System activity feed
    match /system_activities/{activityId} {
      allow read, create: if isStaff();
      allow update: if false;
      allow delete: if false;
    }

    // 8. System Settings & LINE OA Integration
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // 9. Work Jobs (7-Phase Workflow & Operations)
    match /work_jobs/{jobId} {
      allow read, write: if isStaff();
    }
  }
}
