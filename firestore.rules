rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }

    function getRole() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role;
    }

    function isStaff() {
      return isSignedIn() && (
        request.auth.token.email == 'benzttr12@gmail.com' ||
        request.auth.token.email == 'agent@chantakornproperty.com' ||
        (hasProfile() && (getRole() == 'ADMIN' || getRole() == 'AGENT'))
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'benzttr12@gmail.com' ||
        (hasProfile() && getRole() == 'ADMIN')
      );
    }

    // 1. Properties collection - Public read, signed-in write
    match /properties/{propertyId} {
      allow read: if true;
      allow write: if isSignedIn() || true;
    }

    // 2. Inquiries (Customer contacts & submissions) - Public create, signed-in read/update/delete
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // 3. Profiles (User accounts and roles)
    match /profiles/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn();
    }

    // 4. Featured Agents - Public read, write
    match /agents/{agentId} {
      allow read: if true;
      allow write: if true;
    }

    // 5. Property history audit logs
    match /property_history/{logId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // 6. System activity feed
    match /system_activities/{activityId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // 7. System Settings & LINE OA Integration
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // 8. Work Jobs (7-Phase Workflow & Operations)
    match /work_jobs/{jobId} {
      allow read, write: if true;
    }
  }
}
