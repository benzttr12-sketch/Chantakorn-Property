rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    function isStaff() {
      return isSignedIn() && request.auth.token.email_verified == true && (
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        (getUserData().role == 'ADMIN' || getUserData().role == 'AGENT')
      );
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email_verified == true && (
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        getUserData().role == 'ADMIN'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 1. Global safety net (Default deny catch-all)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Properties collection
    match /properties/{propertyId} {
      allow read: if isStaff();
      allow create, update, delete: if isStaff();
    }

    // 3. Inquiries (Customer contacts/submissions)
    match /inquiries/{inquiryId} {
      allow create: if isStaff(); // Public forms use the validated server submission API.
      allow read, update, delete: if isStaff(); // confidential inbox
    }

    // 4. Profiles (User accounts and roles)
    match /profiles/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isStaff() ||
        resource.data.role in ['ADMIN', 'AGENT']
      );

      // Prevent self-assigned roles during signup (must register as USER)
      allow create: if isOwner(userId) && request.resource.data.role == 'USER';

      // Owners can edit their own profile fields except 'role' (privilege escalation protection)
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) || isAdmin();

      allow delete: if isAdmin();
    }

    // 5. Featured Agents
    match /agents/{agentId} {
      allow read: if true; // public team info
      allow write: if isStaff();
    }

    function isValidReview(data, reviewId) {
      return data.keys().hasAll(['id', 'customerName', 'customerRole', 'propertyTitleOrZone', 'agentName', 'rating', 'comment', 'date', 'verifiedBuyer', 'serviceType', 'published'])
        && data.keys().hasOnly(['id', 'customerName', 'customerRole', 'propertyTitleOrZone', 'agentName', 'rating', 'comment', 'date', 'avatarUrl', 'verifiedBuyer', 'serviceType', 'published'])
        && data.id is string && data.id == reviewId && data.id.size() <= 120
        && data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 120
        && data.customerRole is string && data.customerRole.size() <= 250
        && data.propertyTitleOrZone is string && data.propertyTitleOrZone.size() <= 250
        && data.agentName is string && data.agentName.size() <= 150
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() > 0 && data.comment.size() <= 4000
        && data.date is string && data.date.size() > 0 && data.date.size() <= 40
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 2000 && (data.avatarUrl == '' || data.avatarUrl.matches('https://.*'))))
        && data.verifiedBuyer is bool && data.published is bool
        && data.serviceType in ['buy', 'sell', 'rent', 'consignment'];
    }

    // Public queries must include published == true; drafts are staff-only.
    match /reviews/{reviewId} {
      allow read: if isStaff() || resource.data.published == true;
      allow create, update: if isStaff() && isValidReview(request.resource.data, reviewId);
      allow delete: if isStaff();
    }

    // 6. Property history audit logs
    match /property_history/{logId} {
      allow read, create: if isStaff();
      allow update: if false;
      allow delete: if false;
    }

    // 7. System activity feed
    match /system_activities/{activityId} {
      allow read, create: if isStaff();
      allow update: if false;
      allow delete: if false;
    }

    // 8. System Settings & LINE OA Integration
    match /settings/{settingId} {
      // Integration settings may contain operational data; only staff can access them.
      allow read, write: if isStaff();
    }

    // 9. Work Jobs (7-Phase Workflow & Operations)
    match /work_jobs/{jobId} {
      allow read, write: if isStaff();
    }

    // Server media and public-form staging are private. Only staff can view customer photos.
    match /inquiry_media/{mediaId} {
      allow read: if isStaff();
    }
    match /property_media/{mediaId} {
      allow read, delete: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['property_id', 'data_url', 'created_at'])
        && request.resource.data.property_id is string && request.resource.data.property_id.size() <= 256
        && request.resource.data.data_url is string && request.resource.data.data_url.size() <= 1013400
        && request.resource.data.data_url.matches('data:image/(jpeg|png|webp);base64,.*')
        && request.resource.data.created_at is string;
      allow update: if false;
    }

    // Only the signature-verified webhook may register followers through its server identity.
    match /line_followers/{followerId} {
      allow create, update: if false;
      allow read, delete: if isStaff();
    }
  }
}
